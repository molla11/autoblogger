# Local: copy to .env.local. Never commit credentials.
OPENROUTER_API_KEY=
GHOST_URL=https://cms.shinem.dev
GHOST_ADMIN_API_KEY=
OPENROUTER_TEST_BUDGET=20
AUTH_MODE=local
API_HOST=127.0.0.1
API_PORT=4000
WEB_URL=http://localhost:3000
# AUTO_SUMMARIES=false disables automatic paid summaries while replaying fixtures.
# AUTO_SUMMARIES=false
# Optional local full PostgreSQL + Redis. Otherwise PGlite/in-process jobs.
# DATABASE_URL=postgresql://autoblogger:local-only@127.0.0.1:5432/autoblogger
# REDIS_URL=redis://127.0.0.1:6379
# Production (instructions in docs/message.txt; not needed for local tests):
# AUTH_MODE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# ENCRYPTION_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_API_URL=https://your-api.example/api
